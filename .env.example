# --- SOHAM.LICENSE (required for the site to serve anything) ---
# Generate both with: node scripts/generate-license-hash.js
LICENSE_KEY=
LICENSE_KEY_HASH=

# --- Admin login (required for /admin) ---
# Generate the hash with: node scripts/generate-admin-hash.js "YourPassword"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Server ---
PORT=3000
NODE_ENV=production
