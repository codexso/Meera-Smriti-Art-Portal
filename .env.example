# --- SOHAM.LICENSE (required for the site to serve anything) ---
# Generate both with: node scripts/generate-license-hash.js
LICENSE_KEY=
LICENSE_KEY_HASH=

# --- Admin login (required for /admin) ---
# Generate the hash with: node scripts/generate-admin-hash.js "YourPassword"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# --- Instructor login (optional second role, lighter permissions) ---
# Leave both blank to disable the instructor role entirely.
# Generate the hash the same way: node scripts/generate-admin-hash.js "TeacherPassword"
INSTRUCTOR_USERNAME=
INSTRUCTOR_PASSWORD_HASH=

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Server ---
PORT=3000
NODE_ENV=production

# --- Optional: email notifications on new enquiries ---
# If any of these are missing, email notifications are simply skipped --
# enquiries still show up fine in the admin dashboard either way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
